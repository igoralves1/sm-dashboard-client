VITE_AWS_REGION=your-aws-region
VITE_IDENTITY_POOL_ID=your-identity-pool-id
VITE_USER_POOL_ID=your-user-pool-id
VITE_COGNITO_CLIENT_ID=your-cognito-app-client-id
VITE_TIMESTREAM_DB=your-timestream-database-name
VITE_TIMESTREAM_TABLE_RT=your-realtime-table-name
VITE_TIMESTREAM_TABLE_HOURLY=your-hourly-table-name
VITE_TIMESTREAM_TABLE_DAILY=your-daily-table-name
VITE_S3_ACTIVITY_BUCKET=your-s3-activity-bucket-name
VITE_SENSOR_RAP_SIL=your-sensor-id
VITE_SENSOR_PTP_01=your-sensor-id
VITE_SENSOR_PTP_02=your-sensor-id
VITE_SENSOR_PTP_03=your-sensor-id
VITE_SENSOR_PTP_04=your-sensor-id
VITE_SENSOR_RAP_MIR=your-sensor-id
VITE_SENSOR_PTP_07=your-sensor-id

# Service account used by scripts/energisa-token.sh to mint tokens for
# API verification without a browser. Create it with admin-create-user.
ENERGISA_VERIFY_USER=
ENERGISA_VERIFY_PASSWORD=

# ── Energisa energy dashboard ────────────────────────────────────────────────
# Public client identifiers for the Energisa data plane. These are the same
# values the newdash.simemap.com bundle ships to every browser.
VITE_ENERGISA_USER_POOL_ID=us-east-2_SFrYV4huf
VITE_ENERGISA_CLIENT_ID=1u2g9ethgmq0qkrnjtdfa2i3n
VITE_ENERGISA_IDENTITY_POOL_ID=us-east-2:4ef0bcf5-cbd5-4b57-8fa5-c27c9a07748e
VITE_ENERGISA_PUBSUB_ENDPOINT=wss://a23kawqisrluu3-ats.iot.us-east-2.amazonaws.com
VITE_ENERGISA_TENANTS_API=https://api.simemap.com/tenants
VITE_ENERGISA_DEVICES_API=https://7nn23x3eqh.execute-api.us-east-2.amazonaws.com/prod

# Organization-scoped host. The device inventory comes from here, not from the
# tenants API — tenants/devices ignores organization selection and returns a
# different tenant's devices entirely.
VITE_ENERGISA_API=https://simemap-api-dev.qaerpliib426a.us-east-1.cs.amazonlightsail.com
VITE_ENERGISA_ORG_ID=a51db866-3e38-4e46-ac6a-f95fda3d3636

# Demo account for the Energisa section. It MUST already belong to the
# Energisa organization — a newly created user authenticates fine but returns
# 204 with an empty device list, because membership lives in the backend DB.
# Username, not email: the Energisa pool has no username-attribute aliasing.
#
# WARNING: VITE_* values are inlined into the JavaScript bundle at build time,
# so this password is readable by anyone who loads the page. Safe for a local
# demo; do not deploy publicly until the identity pool's authenticated role is
# scoped down (it currently carries AdministratorAccess).
VITE_ENERGISA_USER=
VITE_ENERGISA_PASSWORD=
